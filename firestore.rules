rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/data {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validSnapshot() {
        return request.resource.data.keys().hasOnly(['state', 'revision', 'updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.state.expenses is list
          && request.resource.data.revision is string
          && request.resource.data.revision.size() > 0
          && request.resource.data.revision.size() <= 128
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if isOwner();
      allow create: if isOwner() && validSnapshot();
      allow update: if isOwner() && validSnapshot()
        && request.resource.data.revision != resource.data.get('revision', '');
    }
  }
}
